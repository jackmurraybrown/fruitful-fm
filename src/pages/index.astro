---
import Layout from "../layouts/Layout.astro";
---

<Layout title="fruitful.fm">
  <h1 id="title" class="text-center my-6">fruitful.fm</h1>
  <h2 class="flex gap-6 mx-auto mb-24">
    <span class="rotate-9 inline-block">open-source</span>
    <span class="-rotate-5 inline-block">tools for community radio</span>
    <span class="rotate-5 inline-block">free from big tech</span>
    <span class="-rotate-5 inline-block">lots of fuuuun!</span>
  </h2>

  <marquee class="text-primary text-6xl mb-24"
    >tend your garden, tune into community radio</marquee
  >

  <p>
    <dfn class="italic">fruitful</dfn> - producing fruit, especially in abundance.
  </p>

  <h3>toolshed</h3>
  <h4>streaming + scheduling</h4>
  <p>
    schedule shows and broadcast to your listeners. bring your own archive so
    you don't run out of storage.
  </p>

  <h4>tracklisting</h4>
  <p>automated tracklists directly from your studio and equipment</p>

  <h4>archiving</h4>
  <p>tools for editing and archiving your shows post broadcast</p>

  <h4>peer-to-peer</h4>
  <p>internet radio without the server.</p>
</Layout>

<style>
  h1 {
    font-size: 6rem;
    text-shadow: var(--color-primary) 0.46789px 0.467891px 9px;
    -webkit-text-stroke: 4px var(--color-primary);
  }
</style>
